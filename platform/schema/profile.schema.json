{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://como-model/platform/profile.schema.json",
  "title": "Buyer Profile",
  "description": "A declarative, user-owned profile. Holds PREFERENCES only. It never holds engine assumptions (anchors, elasticities, scenario logic) - those live in the governed engine. Adding a user or an asset class = adding one of these files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "asset_class", "geography", "budget_band", "criteria"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "stable slug, used in URLs and bundle paths" },
    "label": { "type": "string" },
    "asset_class": { "type": "string", "enum": ["residential", "commercial"], "description": "selects the engine strategy + valuation basis" },
    "currency": { "type": "string", "default": "AUD" },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "market"],
      "properties": {
        "anchor": {
          "type": "object", "additionalProperties": false, "required": ["name"],
          "properties": { "name": { "type": "string" }, "postcode": { "type": "string" } }
        },
        "market": { "type": "string" },
        "candidates": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget_band": {
      "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 },
      "description": "[min, max]. A soft ceiling - listing prices are estimates, not sale prices."
    },
    "horizon_years": {
      "type": "object", "additionalProperties": false,
      "properties": { "primary": { "type": "number" }, "tail": { "type": "number" } }
    },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "type"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string", "enum": ["filter", "weight", "context"] },
          "value": {},
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "data_sources": { "type": "array", "items": { "type": "string" } }
  }
}
